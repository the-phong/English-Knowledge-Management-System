{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_INTERNAL_URL"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": ["API_INTERNAL_URL"],
      "cache": false,
      "persistent": true
    },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["build"], "outputs": [] },
    "test:integration": {
      "dependsOn": ["build"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "NODE_ENV",
        "JWT_SIGNING_KEY_B64",
        "REFRESH_PEPPER_B64",
        "JWT_ISSUER",
        "JWT_AUDIENCE",
        "AUTH_ALLOWED_ORIGINS",
        "AUTH_COOKIE_SECURE",
        "AUTH_LOGIN_IP_LIMIT",
        "AUTH_LOGIN_ACCOUNT_LIMIT",
        "AUTH_REGISTER_IP_LIMIT",
        "AUTH_REFRESH_IP_LIMIT"
      ],
      "outputs": []
    }
  }
}
