generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Importance {
  LOW
  NORMAL
  HIGH
}

enum LearningState {
  NEW
  LEARNING
  PRACTICING
  MASTERED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ActivityType {
  RECOGNITION
  RECALL
  PRODUCTION
}

enum AttemptResult {
  AGAIN
  HARD
  GOOD
  EASY
  NEEDS_REVIEW
}

enum WritingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  normalizedEmail    String             @unique @map("normalized_email")
  passwordHash       String             @map("password_hash")
  displayName        String?            @map("display_name")
  timezone           String             @default("Asia/Bangkok")
  dailyMinutes       Int                @default(10) @map("daily_minutes")
  maxNewItemsPerDay  Int                @default(5) @map("max_new_items_per_day")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  refreshSessions    RefreshSession[]
  vocabularyItems    VocabularyItem[]
  contextTags        ContextTag[]
  learningSessions   LearningSession[]
  learningAttempts   LearningAttempt[]
  writingSubmissions WritingSubmission[]
  masteryChanges     MasteryChange[]
  securityEvents     SecurityEvent[]
  @@map("users")
}

model RefreshSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  familyId    String    @map("family_id")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedById String?  @unique @map("replaced_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy  RefreshSession?  @relation("RefreshRotation", fields: [replacedById], references: [id])
  replaces    RefreshSession[] @relation("RefreshRotation")
  securityEvents SecurityEvent[]
  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

model SecurityEvent {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  refreshSessionId String?         @map("refresh_session_id")
  type             String
  metadata         Json?
  createdAt        DateTime        @default(now()) @map("created_at")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshSession   RefreshSession? @relation(fields: [refreshSessionId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@map("security_events")
}

model Lexeme {
  id                 String             @id @default(uuid())
  lemma              String
  normalizedLemma    String             @map("normalized_lemma")
  language           String             @default("en")
  partOfSpeech       String             @default("UNKNOWN") @map("part_of_speech")
  dictionarySenses   DictionarySense[]
  vocabularyItems    VocabularyItem[]
  @@unique([normalizedLemma, language, partOfSpeech])
  @@map("lexemes")
}

model DictionarySense {
  id              String          @id @default(uuid())
  lexemeId        String          @map("lexeme_id")
  provider        String
  providerSenseId String?         @map("provider_sense_id")
  definition      String
  rawData         Json?           @map("raw_data")
  fetchedAt       DateTime        @default(now()) @map("fetched_at")
  lexeme          Lexeme          @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  vocabularyItems VocabularyItem[]
  @@index([lexemeId])
  @@map("dictionary_senses")
}

model VocabularyItem {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  lexemeId         String            @map("lexeme_id")
  dictionarySenseId String?          @map("dictionary_sense_id")
  definitionVi     String            @map("definition_vi")
  sourceContext    String?           @map("source_context")
  sourceName       String?           @map("source_name")
  sourceUrl        String?           @map("source_url")
  importance       Importance        @default(NORMAL)
  archivedAt       DateTime?         @map("archived_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lexeme           Lexeme            @relation(fields: [lexemeId], references: [id])
  dictionarySense  DictionarySense? @relation(fields: [dictionarySenseId], references: [id])
  vocabularyTags    VocabularyTag[]
  sessionItems      SessionItem[]
  attempts          LearningAttempt[]
  mastery          MasterySnapshot?
  masteryChanges    MasteryChange[]
  writingSubmissions WritingSubmission[]
  @@index([userId, archivedAt, createdAt])
  @@map("vocabulary_items")
}

model ContextTag {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  name            String
  normalizedName  String           @map("normalized_name")
  createdAt       DateTime         @default(now()) @map("created_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyTags  VocabularyTag[]
  @@unique([userId, normalizedName])
  @@map("context_tags")
}

model VocabularyTag {
  vocabularyItemId String         @map("vocabulary_item_id")
  contextTagId     String         @map("context_tag_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  vocabularyItem   VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)
  contextTag       ContextTag     @relation(fields: [contextTagId], references: [id], onDelete: Cascade)
  @@id([vocabularyItemId, contextTagId])
  @@map("vocabulary_tags")
}

model LearningSession {
  id                String          @id @default(uuid())
  userId            String          @map("user_id")
  status            SessionStatus   @default(ACTIVE)
  targetMinutes     Int             @map("target_minutes")
  plannedItemCount  Int             @map("planned_item_count")
  startedAt         DateTime        @default(now()) @map("started_at")
  completedAt       DateTime?       @map("completed_at")
  expiresAt         DateTime        @map("expires_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             SessionItem[]
  @@index([userId, status, startedAt])
  @@map("learning_sessions")
}

model SessionItem {
  id               String           @id @default(uuid())
  sessionId        String           @map("session_id")
  vocabularyItemId String           @map("vocabulary_item_id")
  activityType     ActivityType     @map("activity_type")
  position         Int
  selectionReasons Json?            @map("selection_reasons")
  completedAt      DateTime?        @map("completed_at")
  session          LearningSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem   @relation(fields: [vocabularyItemId], references: [id])
  attempts         LearningAttempt[]
  @@unique([sessionId, position])
  @@index([sessionId, completedAt])
  @@map("session_items")
}

model LearningAttempt {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  vocabularyItemId String         @map("vocabulary_item_id")
  sessionItemId    String?        @map("session_item_id")
  activityType     ActivityType   @map("activity_type")
  answerText       String?        @map("answer_text")
  result           AttemptResult
  wasCorrect       Boolean        @map("was_correct")
  usedHint         Boolean        @default(false) @map("used_hint")
  responseTimeMs   Int?           @map("response_time_ms")
  idempotencyKey   String         @map("idempotency_key")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem @relation(fields: [vocabularyItemId], references: [id])
  sessionItem      SessionItem?   @relation(fields: [sessionItemId], references: [id])
  @@unique([userId, idempotencyKey])
  @@index([vocabularyItemId, createdAt])
  @@map("learning_attempts")
}

model MasterySnapshot {
  id                  String        @id @default(uuid())
  vocabularyItemId    String        @unique @map("vocabulary_item_id")
  recognitionScore    Int           @default(0) @map("recognition_score")
  recallScore         Int           @default(0) @map("recall_score")
  productionScore     Int           @default(0) @map("production_score")
  learningState       LearningState @default(NEW) @map("learning_state")
  reviewStage         Int           @default(0) @map("review_stage")
  nextReviewAt        DateTime?     @map("next_review_at")
  version             Int           @default(0)
  scoringRuleVersion  Int           @default(1) @map("scoring_rule_version")
  schedulingRuleVersion Int         @default(1) @map("scheduling_rule_version")
  vocabularyItem      VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)
  @@index([nextReviewAt])
  @@map("mastery_snapshots")
}

model MasteryChange {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  vocabularyItemId String          @map("vocabulary_item_id")
  sourceAttemptId  String?         @map("source_attempt_id")
  beforeSnapshot   Json            @map("before_snapshot")
  afterSnapshot    Json            @map("after_snapshot")
  reason           String
  ruleVersion      Int             @map("rule_version")
  createdAt        DateTime        @default(now()) @map("created_at")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem  @relation(fields: [vocabularyItemId], references: [id])
  @@index([vocabularyItemId, createdAt])
  @@map("mastery_changes")
}

model WritingSubmission {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  vocabularyItemId String           @map("vocabulary_item_id")
  text             String
  revisionOfId     String?          @map("revision_of_id")
  status           WritingStatus    @default(PENDING)
  failureCode      String?          @map("failure_code")
  attemptCount     Int              @default(0) @map("attempt_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem   @relation(fields: [vocabularyItemId], references: [id])
  revisionOf       WritingSubmission? @relation("WritingRevisions", fields: [revisionOfId], references: [id])
  revisions        WritingSubmission[] @relation("WritingRevisions")
  aiEvaluations    AIEvaluation[]
  @@index([userId, status, createdAt])
  @@map("writing_submissions")
}

model AIEvaluation {
  id                 String           @id @default(uuid())
  writingSubmissionId String          @map("writing_submission_id")
  provider           String
  model              String
  promptVersion      String           @map("prompt_version")
  schemaVersion      String           @map("schema_version")
  usesTargetSense    Boolean          @map("uses_target_sense")
  outcome            String
  confidence         Float
  grammarIssues      Json             @map("grammar_issues")
  wordChoiceIssues   Json             @map("word_choice_issues")
  suggestedSentence  String?          @map("suggested_sentence")
  explanationVi      String?          @map("explanation_vi")
  latencyMs          Int?             @map("latency_ms")
  inputTokens        Int?             @map("input_tokens")
  outputTokens       Int?             @map("output_tokens")
  createdAt          DateTime         @default(now()) @map("created_at")
  writingSubmission  WritingSubmission @relation(fields: [writingSubmissionId], references: [id], onDelete: Cascade)
  @@index([writingSubmissionId, createdAt])
  @@map("ai_evaluations")
}
