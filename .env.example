# Local development placeholders only. Copy to .env and keep .env untracked.
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://ekms_dev:replace-with-local-secret@localhost:5432/ekms_dev?schema=public
REDIS_URL=redis://localhost:6379
API_INTERNAL_URL=http://localhost:3001
POSTGRES_USER=ekms_dev
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_DB=ekms_dev
JWT_SIGNING_KEY_B64=replace-with-independent-base64-32-byte-secret
REFRESH_PEPPER_B64=replace-with-another-base64-32-byte-secret
JWT_ISSUER=ekms-local
JWT_AUDIENCE=ekms-web
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTH_COOKIE_SECURE=false
# Local proxy requests share one API socket peer. Account limit remains strict.
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_REGISTER_IP_LIMIT=100
AUTH_REFRESH_IP_LIMIT=100
