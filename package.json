{
  "name": "english-knowledge-system",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "db:generate": "pnpm --filter @ekms/api prisma:generate",
    "db:migrate": "pnpm --filter @ekms/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @ekms/api prisma:migrate:deploy",
    "db:migrate:status": "pnpm --filter @ekms/api prisma:migrate:status",
    "db:seed": "pnpm --filter @ekms/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.35.0",
    "turbo": "^2.5.6",
    "typescript-eslint": "^8.42.0",
    "typescript": "^5.9.2"
  }
}
